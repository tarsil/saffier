{% extends "admin/base.html.jinja" %}

{% block header %}{{ title }}{% endblock %}

{% block content %}
<div class="bg-white border border-gray-200 rounded-lg shadow-sm w-full px-6 py-6">
  <div class="space-y-6">
    {% for field in model_fields %}
      {% set value = values.get(field.name) %}
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2">
        <dt class="text-sm {% if field.primary_key %}font-extrabold{% else %}font-semibold{% endif %} text-gray-800 w-full sm:w-1/4">
          {{ field.name.replace('_', ' ') | title }}
        </dt>
        <dd class="text-sm text-gray-900 bg-gray-50 px-4 py-2 rounded-md border border-gray-100 w-full sm:w-3/4 break-words">
          {% if value is not none %}
            {{ value }}
          {% else %}
            -
          {% endif %}
        </dd>
      </div>
    {% endfor %}
  </div>

  <div class="mt-8 flex flex-wrap gap-4 border-t pt-6">
    <a href="{{ admin_url('admin_model_edit', name=model_name, pk=object_pk) }}"
       class="inline-block px-5 py-2 bg-blue-600 text-white text-sm font-medium rounded hover:bg-blue-700">
      Edit
    </a>
    <form method="post"
          action="{{ admin_url('admin_model_delete', name=model_name, pk=object_pk) }}"
          onsubmit="return confirm('Are you sure you want to delete this?');">
      <button type="submit"
              class="px-5 py-2 bg-red-600 text-white text-sm font-medium rounded hover:bg-red-700">
        Delete
      </button>
    </form>
  </div>
</div>
{% endblock %}
