<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="{{ favicon }}"/>
  <title>{{ page_title }} | {{ title }}</title>
  {% include 'admin/base_head.html.jinja' %}
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center">
  <div class="text-center">
    <h1 class="text-9xl font-bold text-gray-700">404</h1>
    <p class="text-2xl md:text-3xl font-light leading-normal mb-8">
      Sorry, we could not find the page you are looking for.
    </p>
    <p class="text-gray-600 mb-8">
      The admin page you requested might have been moved or does not exist.
    </p>
    <a href="{{ admin_url('admin_dashboard') }}" class="text-blue-500 hover:underline text-lg">
      Go back to the admin dashboard
    </a>
  </div>
</body>
</html>
